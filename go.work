go 1.26.10

// SLUG development workspace. The fork is ten Go modules that pin each
// other by released version; without this file, a change in one module
// (for example the Argon2id BlockHash in wire) is invisible to the
// modules that depend on it. The workspace makes every build and test
// in this repo resolve the btcd modules to the local sources.
//
// This is development scaffolding for the fork's build-out phase. It
// can be dropped once the modules are versioned and released under
// their own tags.
use (
	.
	./address
	./btcec
	./btcutil
	./chaincfg
	./chainhash
	./psbt
	./txscript
	./v2transport
	./wire
)
