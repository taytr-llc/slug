-	if e != nil || len(raw) > actualMinerMaxBytes+(1<<20) {
-		return actualMinerError("public evidence size")
-	}
-	f, e := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
-	if e != nil {
-		return actualMinerError("public evidence create")
-	}
-	_, we := f.Write(append(raw, '\n'))
-	se, ce := f.Sync(), f.Close()
-	if we != nil || se != nil || ce != nil {
-		return actualMinerError("public evidence close")
-	}
-	return nil
-}
