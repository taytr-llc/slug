-func actualMinerResolved(row prospectworker.PoolEntry) bool {
-	switch row.PoolState {
-	case "accepted", "not-applicable", "expired", "rejected":
-	default:
-		return false
-	}
-	if f := row.Fighter; f != nil {
-		switch f.BlockState {
-		case "not-applicable", "canonical", "rejected":
-		default:
-			return false
-		}
-		switch f.AdmissionState {
-		case "not-applicable", "accepted", "expired", "rejected":
-		default:
-			return false
-		}
-	}
-	return true
-}
