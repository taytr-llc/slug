-func actualMinerEntries(box *prospectworker.PoolOutbox) ([]prospectworker.PoolEntry, error) {
-	rows := make([]prospectworker.PoolEntry, 0)
-	var after uint64
-	for len(rows) < actualMinerMaxRecords {
-		page, e := box.List(after, actualMinerMaxRecords-len(rows))
-		if e != nil {
-			return nil, e
-		}
-		if len(page) == 0 {
-			return rows, nil
-		}
-		for _, row := range page {
-			if row.Sequence != after+1 {
-				return nil, actualMinerError("outbox sequence")
-			}
-			after = row.Sequence
-			rows = append(rows, row)
-		}
-	}
-	page, e := box.List(after, 1)
-	if e != nil || len(page) != 0 {
-		return nil, actualMinerError("outbox capacity")
-	}
-	return rows, nil
-}
