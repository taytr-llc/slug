-func actualMinerRowsHash(rows []prospectworker.PoolEntry) (string, error) {
-	raw, e := json.Marshal(rows)
-	if e != nil || len(raw) > actualMinerMaxBytes {
-		return "", actualMinerError("public rows size")
-	}
-	sum := sha256.Sum256(raw)
-	return hex.EncodeToString(sum[:]), nil
-}
